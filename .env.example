# Copy this file to .env and fill in ONE key. Never commit .env.
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# groq | gemini | openai | mock
LLM_PROVIDER=groq
# Leave empty for the provider default (groq: openai/gpt-oss-120b, gemini: gemini-2.5-flash, openai: gpt-4o-mini).
# List what your key can use: python -m src.llm --list-models
LLM_MODEL=
# Optional: reasoning effort for reasoning models (gpt-oss): low (default) | medium | high | none
LLM_REASONING_EFFORT=
# Requests per minute (minimum spacing between calls = 60 / LLM_RPM seconds).
# Groq free tier allows about 8,000 tokens per minute and a V3/V4 call uses about 3,100 tokens, so 2 is a safe value
# for the full evaluation (at 4, V3/V4 calls go over that limit and are throttled and retried).
LLM_RPM=20
